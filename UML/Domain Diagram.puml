@startuml

class Program {
        - penDown : boolean
        - variables : Map<String, Variable>
}

class Character {
        - degrees : integer

    }
class Coordinates {
    - x: double
    - y: double
}

abstract class Instruction {
    - Name : string
}


abstract class Movement extends Instruction {
     - direction : integer
     }


class Rotation extends Movement

class Translation extends Movement {
    - distance : integer
    }

class Line {
}

class Shape {

}

class PenAction extends Instruction {

}

enum InstructionType {
    MOVE_FORWARD
    MOVE_BACKWARD
    TURN_LEFT
    TURN_RIGHT
    PEN_UP
    PEN_DOWN
    VAR_DECLARATION
    VAR_ASSIGNMENT
    INCREMENT_VARIABLE
    REPEAT
    END_REPEAT
}

class Variable extends Value {
    - nameVar : string
}

abstract class VarAction extends Instruction {

}

class VarDeclaration extends VarAction {

}

class VarAssignment extends VarAction {

}

class IncrementVar extends VarAction {
    - amount : integer
}

abstract class Loop extends Instruction {

}

class Repeat extends Loop {

}

class Value {
    - value : integer
}

' --- RELATIONS --- '

InstructionType -- Instruction
Character -->  Coordinates : has
Program --> Character :  moves
Program "1" --> "*" Instruction : executes
Shape "1" --> "*" Line : contains
Program "1" --> "*" Line : draws
Line "1" --> "2" Coordinates : has
Instruction --> Variable : has
VarAction --> Variable : defines
Loop --> Value : uses
Loop "1" *--> "*" Instruction : contains (Composite)
Movement --> Value : has

@end