@startuml

class Program {
        - penDown : boolean
}

class Character {
        - degrees : integer

    }
class Coordinate {
    - x: double
    - y: double
}

abstract class Instruction {
    - Name : string
}
enum PenMovement {
    PEN_UP
    PEN_DOWN
}


abstract class Movement extends Instruction {
     - direction : integer
     }


class Rotation extends Movement

class Translation extends Movement {
    - distance : integer
    }

class Line {
}

class Shape {

}

class PenAction extends Instruction {

}


enum MovementType {
    FORWARD
    BACKWARDS
    LEFT
    RIGHT
}



' --- RELATIONS --- '

MovementType -- Movement
Character "1" --> "1" Coordinate : has
Program --> Character :  moves
Program "1" --> "*" Instruction : executes
Shape "1" --> "*" Line : contains
Program "1" --> "*" Line : draws
Line "1" --> "2" Coordinate : has
PenMovement -- PenAction

@end